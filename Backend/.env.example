# Application Environment
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database (Prisma)
# Transaction Pooler URL (Port 6543) - used by application runtime
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-eu-north-1.pooler.supabase.com:6543/postgres"

# Direct / Session Mode URL (Port 5432) - used by Prisma CLI (migrate, db push)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-eu-north-1.pooler.supabase.com:5432/postgres"

# Authentication & Security
JWT_SECRET=super-secret-jwt-key-replace-in-production
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=super-secret-refresh-key-replace-in-production
JWT_REFRESH_EXPIRATION=30d
